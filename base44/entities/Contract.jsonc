{
  "name": "Contract",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "contract_number": {
      "type": "string"
    },
    "equipment": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "payment_terms": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "assinado"
      ],
      "default": "rascunho"
    },
    "notes": {
      "type": "string"
    },
    "content_url": {
      "type": "string",
      "description": "URL do arquivo contendo o texto completo do contrato, livre para edi\u00e7\u00e3o"
    }
  },
  "required": [
    "client_id",
    "contract_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}