{
  "name": "Client",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pf",
        "pj"
      ],
      "default": "pf"
    },
    "name": {
      "type": "string",
      "description": "Nome completo (PF) ou Raz\u00e3o Social (PJ)"
    },
    "trade_name": {
      "type": "string",
      "description": "Nome fantasia (PJ)"
    },
    "document": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "state_registration": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual (PJ)"
    },
    "contact_person": {
      "type": "string",
      "description": "Respons\u00e1vel pelo contato (PJ)"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}