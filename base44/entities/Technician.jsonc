{
  "name": "Technician",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "cnh": {
      "type": "string",
      "description": "N\u00famero/categoria da CNH"
    },
    "resume_url": {
      "type": "string",
      "description": "URL do arquivo de curr\u00edculo"
    },
    "courses": {
      "type": "string",
      "description": "Cursos e capacita\u00e7\u00f5es"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}